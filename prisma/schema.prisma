generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Venue {
  id         String  @id @default(cuid())
  name       String
  currency   String  @default("UYU")
  timezone   String  @default("America/Montevideo")
  isActive   Boolean @default(true)
  tables     Table[]
  drinks     Drink[]
  orders     Order[]
  config     Config?
  happyRules HappyHourRule[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Table {
  id        String  @id @default(cuid())
  venueId   String
  venue     Venue   @relation(fields: [venueId], references: [id])
  number    Int
  alias     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([venueId, number])
}

model Drink {
  id         String   @id @default(cuid())
  venueId    String
  venue      Venue    @relation(fields: [venueId], references: [id])
  name       String
  code       String
  basePrice  Decimal  @db.Decimal(10,2)
  minPrice   Decimal  @db.Decimal(10,2)
  maxPrice   Decimal  @db.Decimal(10,2)
  volatility Float    @default(0.05)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  prices     PriceHistory[]
  @@index([venueId, isActive])
}

model PriceHistory {
  id        String   @id @default(cuid())
  drinkId   String
  drink     Drink    @relation(fields: [drinkId], references: [id])
  venueId   String
  ts        DateTime @default(now())
  price     Decimal  @db.Decimal(10,2)
  changePct Float
  reason    String?
  @@index([drinkId, ts])
}

enum OrderStatus {
  PENDING
  ACCEPTED
  IN_PREP
  READY
  DELIVERED
  CANCELED
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

enum OrderSource {
  TABLET
  BAR
}

model Order {
  id           String        @id @default(cuid())
  venueId      String
  venue        Venue         @relation(fields: [venueId], references: [id])
  tableId      String?
  table        Table?        @relation(fields: [tableId], references: [id])
  drinkId      String
  drink        Drink         @relation(fields: [drinkId], references: [id])
  quantity     Int           @default(1)
  priceAtOrder Decimal       @db.Decimal(10,2)
  quoteId      String?
  status       OrderStatus   @default(PENDING)
  payment      PaymentStatus @default(UNPAID)
  source       OrderSource
  note         String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Config {
  id           String  @id @default(cuid())
  venueId      String  @unique
  venue        Venue   @relation(fields: [venueId], references: [id])
  priceTickSec Int     @default(90)
  quoteTtlSec  Int     @default(60)
  currency     String  @default("UYU")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model HappyHourRule {
  id           String  @id @default(cuid())
  venueId      String
  venue        Venue   @relation(fields: [venueId], references: [id])
  daysOfWeek   String  // CSV: MON,TUE,WED,THU,FRI,SAT,SUN
  startLocal   String  // "HH:mm"
  durationMin  Int     // minutos
  discountPct  Float   // 0.15 = 15 %
  active       Boolean @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([venueId, active])
}
